# Copy to .env and fill in, or run `marketplace-finder init`, which creates it
# with a random ntfy topic. Keep .env private: chmod 600, never commit it.

# ntfy topic for private alerts when something breaks. Anyone who knows the name can read them, so keep it long and random.
NTFY_TOPIC=

# Webhook address of the channel listings are posted to (Channel settings > Integrations > Webhooks). Anyone who has it can post there.
DISCORD_WEBHOOK_URL=

# Optional: a second webhook, in a test channel, for `notify-test --test`.
DISCORD_TEST_WEBHOOK_URL=

# eBay Browse API production keyset (https://developer.ebay.com/my/keys). Leave blank to skip eBay.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Only on a machine where `claude` has not been signed in: run `claude setup-token`
# somewhere with a browser and put the token it prints here.
# CLAUDE_CODE_OAUTH_TOKEN=
